# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Upstash Redis (persistent store). On Vercel, add the Upstash integration and
# these are injected automatically. Locally, copy them from the Upstash console.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
